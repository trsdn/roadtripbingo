# Road Trip Bingo - Deployment configuration
# Copy this file to /opt/roadtripbingo/.env and adjust the values.

# Server
PORT=8080
NODE_ENV=production

# Optional: OpenAI integration (AI icon analysis). Leave empty to disable.
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.3
AI_MONTHLY_LIMIT=1000
AI_COST_LIMIT=10.00
