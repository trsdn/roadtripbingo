# Road Trip Bingo - Deployment configuration
# Copy this file to /opt/roadtripbingo/.env and adjust the values.

# Server
PORT=8080
NODE_ENV=production

# Optional: AI chat features (icon analysis, duplicate detection, smart sets).
# Works with any OpenAI-compatible endpoint. Leave OPENAI_API_KEY empty to disable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-5.4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.3

# Optional: AI icon image generation. Requires a real OpenAI API key
# (image generation is not available via OpenAI-compatible chat proxies).
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
